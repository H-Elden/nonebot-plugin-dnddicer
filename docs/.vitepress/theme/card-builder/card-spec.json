{
  "version": 7,
  "groups": [
    {
      "id": "identity",
      "label": "身份",
      "summary": "姓名、种族、等级、职业、子职、背景与故事"
    },
    {
      "id": "core",
      "label": "属性与检定",
      "summary": "六属性、熟练、半熟练、额外加值（豁免与技能加值自动计算）"
    },
    {
      "id": "combat",
      "label": "战斗",
      "summary": "生命值、战斗数值、经验与武器"
    },
    {
      "id": "traits",
      "label": "特性与专长",
      "summary": "专长、种族/职业特性与限定资源"
    },
    {
      "id": "spells",
      "label": "法术",
      "summary": "施法属性、法术清单、法术位与契约法术"
    },
    {
      "id": "gear",
      "label": "装备",
      "summary": "物品、钱币与魔法物品"
    },
    {
      "id": "other",
      "label": "其他",
      "summary": "战斗记录（建卡时无需填写）"
    }
  ],
  "segments": [
    {
      "key": "$姓名$",
      "label": "姓名",
      "group": "identity",
      "required": false,
      "summary": "角色名，检定与先攻列表中使用",
      "example": "伊瑟兰·晨星"
    },
    {
      "key": "$种族$",
      "label": "种族",
      "group": "identity",
      "required": false,
      "summary": "",
      "example": "高等精灵"
    },
    {
      "key": "$职业$",
      "label": "职业",
      "group": "identity",
      "required": false,
      "summary": "",
      "example": "法师"
    },
    {
      "key": "$子职$",
      "label": "子职",
      "group": "identity",
      "required": false,
      "summary": "子职名；达到该规则与职业的子职等级后才显示",
      "example": "塑能师"
    },
    {
      "key": "$背景$",
      "label": "背景",
      "group": "identity",
      "required": false,
      "summary": "",
      "example": "背景:智者; 阵营:中立善良; 信仰:密斯特拉; 体型:中型; 年龄:132; 外貌:银发绿眼，深蓝法袍; 个性:喜欢追问原理"
    },
    {
      "key": "$故事$",
      "label": "故事",
      "group": "identity",
      "required": false,
      "summary": "背景故事，可多段，无需手动打空格缩进，最多 1000 字",
      "example": "伊瑟兰出身于银月城的学者世家，少年时在塔中抄录古籍，一次偶然的星象记录让伊瑟兰看见奥术网络背后的裂隙。\n此后伊瑟兰离开书斋，以旅行者的身份追查那些被刻意抹去的法术痕迹；相信知识应当被分享，但也清楚有些门一旦打开就再难关上。\n如今伊瑟兰随商队来到边境，既是为了寻找失落的抄本，也是为了证明自己不只是导师笔记里的一个名字。"
    },
    {
      "key": "$生命值$",
      "label": "生命值",
      "group": "combat",
      "required": false,
      "summary": "",
      "example": "37/37"
    },
    {
      "key": "$生命骰$",
      "label": "生命骰",
      "group": "combat",
      "required": false,
      "summary": "",
      "example": "5/5 D6"
    },
    {
      "key": "$战斗$",
      "label": "战斗",
      "group": "combat",
      "required": false,
      "summary": "",
      "example": "AC:16; 速度:30"
    },
    {
      "key": "$进度$",
      "label": "进度",
      "group": "combat",
      "required": false,
      "summary": "",
      "example": "经验:6500; 激励:有"
    },
    {
      "key": "$等级$",
      "label": "等级",
      "group": "identity",
      "required": true,
      "summary": "自动计算：熟练加值 = 2 + (等级 - 1) / 4",
      "example": "5"
    },
    {
      "key": "$属性$",
      "label": "属性",
      "group": "core",
      "required": true,
      "summary": "最终的六个属性值",
      "example": "8/14/16/18/11/8"
    },
    {
      "key": "$熟练$",
      "label": "熟练",
      "group": "core",
      "required": false,
      "summary": "",
      "example": "奥秘; 历史; 2*调查; 洞悉; 察觉; 智力豁免; 感知豁免; 武器:简易武器; 工具:书法工具; 语言:通用语,精灵语,龙语"
    },
    {
      "key": "$半熟练$",
      "label": "半熟练",
      "group": "core",
      "required": false,
      "summary": "半熟练只在没有熟练或专精时生效；不同来源取整不同（万事通向下、运动健将向上）。",
      "example": ""
    },
    {
      "key": "$额外加值$",
      "label": "额外加值",
      "group": "core",
      "required": false,
      "summary": "各种检定与豁免的额外加值",
      "example": "豁免:+1"
    },
    {
      "key": "$专长$",
      "label": "专长",
      "group": "traits",
      "required": false,
      "summary": "",
      "example": "魔法学徒（法师）:习得光亮术、心灵之楔与护盾术；护盾术可免法术位施展一次，长休恢复; 属性值提升:智力 +1、感知 +1"
    },
    {
      "key": "$种族特性$",
      "label": "种族特性",
      "group": "traits",
      "required": false,
      "summary": "",
      "example": "黑暗视觉:60 尺内微光视为明亮，黑暗视为微光; 妖精血统:进行避免或结束魅惑状态的豁免时具有优势; 敏锐感官:获得察觉熟练; 出神:无需睡眠，魔法无法使你入睡；4 小时即可完成长休并保持清醒; 高等精灵血系:习得魔法伎俩；3 级习得侦测魔法、5 级习得迷踪步，始终准备，各可免法术位施展一次，长休恢复"
    },
    {
      "key": "$职业特性$",
      "label": "职业特性",
      "group": "traits",
      "required": false,
      "summary": "",
      "example": "1|仪式学家:法术书中的仪式法术可直接以仪式施展，无需准备; 1|奥术回想:短休时恢复总环阶不超过 3 的法术位（6 环以下），每长休一次; 2|学者:获得调查专精; 3|塑能学者:法术书免费加入燃烧之手、粉碎音波与火球术; 3|强力戏法:伤害戏法攻击失手或目标豁免成功时，仍受一半伤害; 5|记忆法术:短休时可研究法术书，替换一道已准备的一环及以上法术"
    },
    {
      "key": "$武器$",
      "label": "武器",
      "group": "combat",
      "required": false,
      "summary": "武器和法术攻击都填在这里",
      "example": "火焰箭+8|2d10火焰|法术攻击, 120尺; 冷冻射线+8|2d8寒冷|法术攻击, 60尺, 速度-10; 匕首+5|1d4+2穿刺|灵巧, 轻型; 长棍+2|1d6-1钝击|奥术法器, 两用(1d8)"
    },
    {
      "key": "$物品$",
      "label": "物品",
      "group": "gear",
      "required": false,
      "summary": "普通物品只填名称与数量，不写详细说明",
      "example": "法术书x1; 长棍x1; 匕首x2; 长袍x1; 学者套组x1; 书法工具x1; 书籍（历史）x1; 羊皮纸x8; 治疗药水x1"
    },
    {
      "key": "$钱币$",
      "label": "钱币",
      "group": "gear",
      "required": false,
      "summary": "",
      "example": "CP:0; SP:0; EP:0; GP:13; PP:0"
    },
    {
      "key": "$限定资源$",
      "label": "限定资源",
      "group": "traits",
      "required": false,
      "summary": "只记录有使用次数的资源，奥术回想、狂暴等",
      "example": "奥术回想:1/1短休|短休时恢复总环阶不超过 3 的法术位（6 环以下），每长休一次; 魔法学徒:1/1长休|无需法术位施展一次护盾术，长休恢复"
    },
    {
      "key": "$魔法物品$",
      "label": "魔法物品",
      "group": "gear",
      "required": false,
      "summary": "特殊物品填在这里，可以写标签和详细说明",
      "example": "战法师魔杖 +1|魔杖，非普通（需施法者同调）|持握这根魔杖期间，你的法术攻击检定获得 +1 加值。//此外，你在进行法术攻击检定时无视半身掩护。; 防护斗篷|奇物，非普通（需同调）|着装此斗篷期间，你的 AC 和豁免获得 +1 加值。"
    },
    {
      "key": "$法术$",
      "label": "法术与法术清单",
      "group": "spells",
      "required": false,
      "summary": "",
      "example": "施法属性:智力; 豁免DC:15; 法术攻击:+8; 火焰箭:0|时间:1动作|距离:120尺|备注:2d10 火焰 / 法术攻击; 冷冻射线:0|时间:1动作|距离:60尺|备注:2d8 寒冷 / 速度-10; 法师之手:0|时间:1动作|距离:30尺|备注:操控物件 / 1分钟; 次级幻象:0|时间:1动作|距离:30尺|材料:是|备注:声音或影像 / 1分钟; 魔法伎俩:0|时间:1动作|距离:10尺|备注:无害小魔法 / 至多1小时; 光亮术:0|时间:1动作|距离:触碰|材料:是|备注:20尺明亮光照 / 1小时; 心灵之楔:0|时间:1动作|距离:60尺|备注:2d6 心灵 / 智力豁免; 护盾术:1*|时间:1反应|距离:自身|备注:+5 AC / 1轮 / 学徒免位1次; 魔法飞弹:1*|时间:1动作|距离:120尺|备注:3d4+3 力场 / 升环+1飞镖; 法师护甲:1*|时间:1动作|距离:触碰|材料:是|备注:AC 13+敏捷 / 8小时; 侦测魔法:1*|时间:1动作或仪式|距离:自身|专注:是|仪式:是|备注:30尺灵光 / 血系免位1次; 羽落术:1*|时间:1反应|距离:60尺|材料:是|备注:至多5个生物 / 1分钟; 迷踪步:2*|时间:1附赠动作|距离:自身|备注:传送30尺 / 血系免位1次; 蛛网术:2*|时间:1动作|距离:60尺|专注:是|材料:是|备注:20尺立方 / 束缚; 镜影术:2*|时间:1动作|距离:自身|备注:3个分身 / 1分钟; 火球术:3*|时间:1动作|距离:150尺|材料:是|备注:20尺半径 / 8d6 火焰 / 敏捷; 闪电束:3*|时间:1动作|距离:自身|材料:是|备注:100尺线 / 8d6 闪电 / 敏捷; 法术反制:3*|时间:1反应|距离:60尺|备注:体质豁免 / 打断施法; 加速术:3*|时间:1动作|距离:30尺|专注:是|材料:是|备注:速度翻倍 / +2 AC / 额外动作"
    },
    {
      "key": "$法术位$",
      "label": "法术位与契约法术",
      "group": "spells",
      "required": false,
      "summary": "",
      "example": "1:4/4; 2:3/3; 3:2/2"
    },
    {
      "key": "$战斗记录$",
      "label": "战斗记录",
      "group": "other",
      "required": false,
      "summary": "建卡时无需填写；开团后由骰娘记录战斗中的临时事项",
      "example": "法师护甲(8小时)"
    }
  ],
